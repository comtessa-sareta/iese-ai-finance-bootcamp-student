# Copy this file to .env and fill in your values. .env is git-ignored — never commit it.

# Anthropic API key — needed from Session 1 (the notebooks call Claude).
# Get one at https://console.anthropic.com/  →  API Keys
ANTHROPIC_API_KEY=

# Model used by the course scripts (toolkit/llm.py reads this).
# claude-sonnet-5           — course default: fast, capable, cost-effective
# claude-haiku-4-5-20251001 — cheapest, fine for experimenting
# claude-opus-5             — strongest reasoning, most expensive
ANTHROPIC_MODEL=claude-sonnet-5

# The SEC asks every automated client to identify itself: "Name email".
# Use YOUR OWN name and email. https://www.sec.gov/os/accessing-edgar-data
SEC_EDGAR_USER_AGENT=Your Name your.email@example.com
